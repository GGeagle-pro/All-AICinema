# 관리자에서 올린 배너 이미지 폴더: 이미지 파일만 열람 허용, 실행 불가
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar .pl .py .cgi .sh
<FilesMatch "\.(?i:webp|png|jpe?g|gif)$">
  Require all granted
</FilesMatch>
<FilesMatch "^(?!.*\.(?i:webp|png|jpe?g|gif)$)">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Content-Security-Policy "default-src 'none'"
</IfModule>
